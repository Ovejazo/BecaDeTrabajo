{#
/**
 * @file
 * Plantilla del bloque Sección Videos - USACH Nivel 3.
 */
#}
<section class="section-videos-nivel3" id="videos">
    <div class="container">
        <div class="section-header-left">
            <h2 class="section-title-orange">{{ seccion_titulo|default('Videos') }}</h2>
        </div>

        <div class="videos-nivel3-grid">
          {% if videos_destacados is not empty %}
            {% for video in videos_destacados %}
              <div class="video-n3-card">
                  <div class="video-n3-thumb-wrapper">
                      <a href="{{ video.url }}">
                          <img src="{{ video.image }}" alt="{{ video.title }}" class="video-n3-thumb">
                          <div class="video-play-red-btn">
                              <svg viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                          </div>
                      </a>
                  </div>
                  <h4 class="video-n3-title">
                      <a href="{{ video.url }}">{{ video.title }}</a>
                  </h4>
                  <a href="{{ video.url }}" class="btn-usach-pill btn-orange-outline">VER VIDEO</a>
              </div>
            {% endfor %}
          {% endif %}
        </div>

        <div style="text-align: center;">
            <a href="#todos-los-videos" class="btn-usach-pill btn-orange-solid">
                VER MÁS VIDEOS
            </a>
        </div>
    </div>
</section>
