<header class="site-header">
  <div class="container-header">
    <div class="header-inner">
      {{ page.header }}
    </div>
  </div>
</header>

{# Si hay un banner o hero #}
{% if page.hero %}
  <section class="seccion-hero">
    {{ page.hero }}
  </section>
{% endif %}

{# Contenido de la página #}
<main class="main-content">
  <div class="container">
    {{ page.content }}
  </div>
</main>

{% if page.footer %}
  <footer class="site-footer">
    <div class="container">
      {{ page.footer }}
    </div>
  </footer>
{% endif %}