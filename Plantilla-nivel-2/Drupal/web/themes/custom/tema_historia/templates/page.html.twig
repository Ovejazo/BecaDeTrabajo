<header class="site-header">
  <div class="container">
    <div class="header-navbar">
      {{ page.header }}
    </div>
  </div>
</header>

<section class="seccion-hero">
  <div class="container">
    {{ page.hero }}
  </div>
</section>

{# ZONA OBLIGATORIA DE DRUPAL #}
<main class="main-content">
  <div class="container">
    {{ page.content }}
  </div>
</main>

<section class="seccion-noticias">
  <div class="container noticias-wrapper">
    
    {# 1. COLUMNA IZQUIERDA: Círculo decorativo con título #}
    <div class="noticias-col-titulo">
      <div class="noticias-circulo">
        <h2 class="noticias-texto">Noticias</h2>
      </div>
    </div>

    {# 2. COLUMNA DERECHA: Las 3 noticias que vienen desde Drupal #}
    <div class="noticias-col-contenido">
      {{ page.noticias }}
    </div>

  </div>
</section>

<section class="seccion-galerias">
  <div class="container">
    
    {# 1. Título centrado #}
    <h2 class="galerias-titulo">Galerías</h2>

    {# 2. Las 3 tarjetas de Drupal #}
    <div class="galerias-grid">
      {{ page.galerias }}
    </div>

    {# 3. Botón inferior "VER MÁS FOTOS" #}
    <div class="galerias-btn-wrapper">
      <a href="/galerias" class="btn-ver-mas-fotos">VER MÁS FOTOS</a>
    </div>

  </div>
</section>

<section class="seccion-destacados bg-azul">
  <div class="container">
    <h2 class="titulo-seccion text-white">Destacados</h2>
    <div class="grid-2-columnas">
      {{ page.destacados }}
    </div>
  </div>
</section>

<footer class="site-footer">
  <div class="container">
    {{ page.footer }}
  </div>
</footer>