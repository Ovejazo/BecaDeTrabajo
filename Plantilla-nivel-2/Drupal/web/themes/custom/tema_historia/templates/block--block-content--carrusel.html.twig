{#
/**
 * @file
 * Plantilla para bloques de tipo Carrusel.
 */
#}
<div{{ attributes.addClass('block-carrusel-wrapper') }}>
  {{ title_prefix }}
  {% if label %}
    <h2{{ title_attributes }}>{{ label }}</h2>
  {% endif %}
  {{ title_suffix }}
  {% block content %}
    {{ content }}
  {% endblock %}
</div>
